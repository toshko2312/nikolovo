# Canonical origin used for metadataBase, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.nikolovo.com

# Flip to "true" once scripts/migrate-to-supabase.ts has run and the data lives in Supabase.
# While false, events and media are read from content/events.ts and served from /public.
USE_SUPABASE=false
# Keep in sync with USE_SUPABASE — client components (admin dialogs) can only read NEXT_PUBLIC_* vars.
NEXT_PUBLIC_USE_SUPABASE=false

# Supabase project — safe to expose (anon key is RLS-restricted to published rows).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token required by the write endpoints (POST/PATCH/DELETE, uploads).
# Also signs the /admin session cookie.
ADMIN_API_TOKEN=

# Password for the /admin login page.
ADMIN_PASSWORD=
